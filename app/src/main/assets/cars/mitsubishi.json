      "signals": [
        {
          "id": "MMC_CVT_PRI_RPM",
          "name": {
            "ru": "Обороты первичного шкива CVT",
            "en": "CVT primary pulley speed"
          },
          "unit": "rpm",
          "dec": 0,
          "group": "other",
          "role": "input_rpm",
          "fmt": {
            "bix": 0,
            "len": 8,
            "mul": 32,
            "div": 1,
            "add": -64,
            "signed": false
          },
          "conf": "OK",
          "src": [
            "https://github.com/shlyahten/CVT/blob/main/PIDs.csv",
            "https://www.dropbox.com/s/arx08y7hsr8ggwf/OUT3.csv?dl=0",
            "https://github.com/OBDb/Mitsubishi-Outlander/blob/main/signalsets/v3/default.json"
          ],
          "note": "(A-2)*32 in the Out-Club/drive2 CSVs and OBDb; the same CSVs also carry a plain A*32 line (torque-bhp) - offset 64 rpm uncertain. Jatco JF011E/JF016E only."
        },
        {
          "id": "MMC_CVT_SEC_RPM",
          "name": {
            "ru": "Обороты вторичного шкива CVT",
            "en": "CVT secondary pulley speed"
          },
          "unit": "rpm",
          "dec": 0,
          "group": "other",
          "role": "output_rpm",
          "fmt": {
            "bix": 8,
            "len": 8,
            "mul": 64,
            "div": 1,
            "add": -128,
            "signed": false
          },
          "conf": "OK",
          "src": [
            "https://github.com/shlyahten/CVT/blob/main/PIDs.csv",
            "https://www.dropbox.com/s/arx08y7hsr8ggwf/OUT3.csv?dl=0",
            "https://github.com/OBDb/Mitsubishi-Outlander/blob/main/signalsets/v3/default.json"
          ],
          "note": "(B-2)*64; a plain B*64 variant is also posted (torque-bhp)."
        },
        {
          "id": "MMC_CVT_RATIO",
          "name": {
            "ru": "Передаточное отношение CVT",
            "en": "CVT actual ratio"
          },
          "unit": "",
          "dec": 2,
          "group": "other",
          "fmt": {
            "bix": 32,
            "len": 8,
            "mul": 1,
            "div": 100,
            "add": 0,
            "signed": false
          },
          "conf": "OK",
          "src": [
            "https://github.com/shlyahten/CVT/blob/main/PIDs.csv",
            "https://www.dropbox.com/s/arx08y7hsr8ggwf/OUT3.csv?dl=0",
            "https://github.com/OBDb/Mitsubishi-Outlander/blob/main/signalsets/v3/default.json"
          ]
        },
        {
          "id": "MMC_CVT_TEMP",
          "name": {
            "ru": "Температура масла вариатора",
            "en": "CVT fluid temp"
          },
          "unit": "°C",
          "dec": 0,
          "group": "main",
          "role": "cvt_temp",
          "fmt": {
            "bix": 104,
            "len": 8,
            "signed": false,
            "poly": [
              -36.6,
              2.302,
              -0.03501,
              0.0003193,
              -1.387e-06,
              2.344e-09
            ]
          },
          "conf": "?",
          "src": [
            "https://www.dropbox.com/s/arx08y7hsr8ggwf/OUT3.csv?dl=0",
            "https://www.drive2.ru/l/7181318/",
            "https://github.com/shlyahten/CVT/blob/main/PIDs.csv"
          ],
          "note": "5th-order fit of byte N from OUT3.csv (drive2, 2014) and shlyahten/CVT PIDs.csv (identical; the repo credits Out-Club/drive2, so likely one lineage -> '?'). Byte position also in OBDb (raw only). Check: N=100 -> 47.5 °C, N=150 -> 74.4 °C. A cubic variant 0.0000286 N^3 - 0.00951 N^2 + 1.46 N - 30.1 is also posted."
        },
        {
          "id": "MMC_CVT_TEMP_RAW",
          "name": {
            "ru": "Температура масла CVT, код АЦП (не °C)",
            "en": "CVT fluid temp, raw count (not °C)"
          },
          "unit": "",
          "dec": 0,
          "group": "other",
          "fmt": {
            "bix": 104,
            "len": 8,
            "mul": 1,
            "div": 1,
            "add": 0,
            "signed": false
          },
          "conf": "OK",
          "src": [
            "https://github.com/shlyahten/CVT/blob/main/PIDs.csv",
            "https://www.dropbox.com/s/arx08y7hsr8ggwf/OUT3.csv?dl=0",
            "https://torque-bhp.com/community/main-forum/07-mitsubishi-outlander/",
            "https://github.com/OBDb/Mitsubishi-Outlander/blob/main/signalsets/v3/default.json"
          ],
          "note": "Byte N, raw sensor count behind MMC_CVT_TEMP - kept for checking the polynomial."
        }
      ]

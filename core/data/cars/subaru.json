  "commands": [
    {
      "hdr": "7E1",
      "rsp": "7E9",
      "svc": "22",
      "did": "1017",
      "rate": "slow",
      "models": [
        "Forester",
        "Outback",
        "Impreza",
        "XV",
        "Legacy"
      ],
      "signals": [
        {
          "id": "SUB_CVT_TEMP",
          "name": {
            "ru": "Температура масла вариатора",
            "en": "CVT fluid temp"
          },
          "unit": "°C",
          "dec": 0,
          "group": "main",
          "role": "cvt_temp",
          "fmt": {
            "bix": 0,
            "len": 8,
            "mul": 1,
            "div": 1,
            "add": -50,
            "signed": false
          },
          "conf": "OK",
          "src": [
            "https://www.subaruoutback.org/threads/help-need-pid-equation-for-subaru-cvt-temp.258273/",
            "https://www.subaruforester.org/threads/2015-need-pid-equation-for-cvtf-temp-check.479937/",
            "https://github.com/OBDb/Subaru-Outback/blob/main/signalsets/v3/default.json"
          ],
          "note": "Forums post the Torque line 221017 / 7E1 / ((A*9)/5)-58 in °F, which is A-50 in °C; OBDb Outback has A-50 from MY2010. Lineartronic cars only; 4EAT/5AT cars (Forester SH, 3.6) will not answer. One 2014 Forester owner got 7F 22 31 with an OBDLink LX (torque-bhp) - may be adapter related."
        }
      ]
    }
  ],
  "features": [
    {
      "ru": "Вариатор Lineartronic (TR580/TR690): температура масла CVT",
      "en": "Lineartronic CVT (TR580/TR690): CVT fluid temperature"
    },
    {
      "ru": "С 2008 г. (Forester SH, Impreza GE/GH, Legacy/Outback BL/BP) — CAN 11 бит 500 кбит/с",
      "en": "From 2008 (Forester SH, Impreza GE/GH, Legacy/Outback BL/BP): 11-bit CAN 500 kbit/s"
    },
    {
      "ru": "Более ранние модели — K-line (ISO 9141 / KWP2000), только стандартный OBD-II",
      "en": "Older cars are K-line (ISO 9141 / KWP2000), standard OBD-II only"
    }
  ]
